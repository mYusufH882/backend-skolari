{
  "kind": "collectionType",
  "collectionName": "job_collections",
  "info": {
    "singularName": "job-collection",
    "pluralName": "job-collections",
    "displayName": "Job collection"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "Department": {
      "type": "enumeration",
      "enum": [
        "Engineering, Product, Sales, Marketing, HR"
      ]
    },
    "Location": {
      "type": "string"
    },
    "Type": {
      "type": "enumeration",
      "enum": [
        "Full-time, Part-time, Contract"
      ]
    },
    "Description": {
      "type": "richtext"
    },
    "Requirements": {
      "type": "json"
    },
    "Benefits": {
      "type": "json"
    },
    "SalaryRange": {
      "type": "string"
    },
    "IsActive": {
      "type": "boolean"
    }
  }
}
